# Python
backend/.venv/
backend/__pycache__/
backend/**/__pycache__/
backend/**/*.pyc
backend/**/*.pyo
*.pyc

# Build outputs
dist/
dist-backend/
build-backend/
frontend/dist/

# Local build script (releases ship the prebuilt installer instead)
build.bat

# Node
frontend/node_modules/
frontend/.venv/

# User data (never commit)
backend/data/
backend/output/
backend/uploads/
backend/logs/
backend/rag/chromadb/
backend/rag/docs/
backend/rag/models/
backend/rag/sync_status.json

# Secrets
backend/config.json
backend/auth_token.txt
backend/port.txt

# Session files quarantined after a failed read (services/session_store.py)
backend/data/*.corrupt-*

# OS
.DS_Store
Thumbs.db
desktop.ini

# IDE
.vscode/
.idea/
.claude/

# Debug dumps
backend/rag/debug_*.html
backend/rag/debug_*.png

# Project-root screenshots
/*.png

# Frontend / Electron build cache
frontend/.vite/
frontend/build/
frontend/out/
frontend/dist-electron/
frontend/win-unpacked/

# Type declaration cache
frontend/**/*.tsbuildinfo

# Test caches
backend/.pytest_cache/
.pytest_cache/

# Code knowledge graph (graphify) - regenerable, ~2.3MB
graphify-out/

# Project instruction file (local-only, see Source of truth inside it)
CLAUDE.md

# Portable memory copy (local-only mirror of path-keyed memory)
docs/memory/

# frontend-v2 (parallel rebuild) build + dependency output
frontend-v2/node_modules/
frontend-v2/dist/
frontend-v2/src-tauri/target/
frontend-v2/.vite/
frontend-v2/**/*.tsbuildinfo
# Regenerated by the Tauri build from capabilities/ and the plugin set, so
# committing it means a diff on every machine that builds.
frontend-v2/src-tauri/gen/

# backend-rs (parallel Rust backend) build output and runtime state
backend-rs/target/
backend-rs/**/*.pdb

# v2 runtime state written beside the v1 backend in a dev run.
# port-rs.txt is the port the Rust backend bound; rag/ holds the local
# corpus, the embedding model and the vector store. All machine-local.
backend/port-rs.txt
backend/config-rs.json
backend/sync_status-rs.json
backend/rag/
