{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Income Tax Legal Reply Agent",
  "version": "2.0.0",
  "identifier": "com.rkvtandco.itaxreplyagent.v2",
  "build": {
    "beforeDevCommand": "npm run dev:web",
    "devUrl": "http://127.0.0.1:5174",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Income Tax Legal Reply Agent",
        "width": 1440,
        "height": 920,
        "minWidth": 720,
        "minHeight": 600,
        "resizable": true,
        "center": true,
        "decorations": false,
        "visible": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "font-src": "'self' data:",
        "img-src": "'self' data: asset: http://asset.localhost",
        "connect-src": "'self' ipc: http://ipc.localhost http://127.0.0.1:8000 http://127.0.0.1:8001 http://127.0.0.1:8002 http://127.0.0.1:8003",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'",
        "frame-ancestors": "'none'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": {
      "../../backend-rs/target/release/backend-rs.exe": "backend-rs.exe"
    },
    "windows": {
      "nsis": {
        "installMode": "both",
        "displayLanguageSelector": false,
        "startMenuFolder": "ITax Reply Agent",
        "compression": "lzma",
        "installerHooks": "./installer.nsh"
      }
    }
  }
}
